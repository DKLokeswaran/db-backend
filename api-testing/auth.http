@baseUrl = http://localhost:8084
@username = {{$dotenv API_USERNAME}}
@password = {{$dotenv API_PASSWORD}}

###

# CSRF bootstrap — issues XSRF-TOKEN cookie (run before any state-changing request).
# Captures the token into csrfToken for X-XSRF-TOKEN on later requests (httpYac).
GET {{baseUrl}}/api/auth/csrf

{{
  const setCookie = response.headers['set-cookie'] ?? response.headers['Set-Cookie'];
  const cookies = Array.isArray(setCookie) ? setCookie : setCookie ? [setCookie] : [];
  const raw = cookies.find((c) => /(?:^|,\s*)XSRF-TOKEN=/i.test(String(c)));
  const match = raw && /(?:^|,\s*)XSRF-TOKEN=([^;]+)/i.exec(String(raw));
  if (!match) {
    throw new Error('XSRF-TOKEN cookie missing from CSRF bootstrap response');
  }
  exports.csrfToken = decodeURIComponent(match[1]);
}}

###

# Login — establishes the session cookie (run after CSRF bootstrap).
# The cookie jar resends JSESSIONID and XSRF-TOKEN on the requests below.
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "username": "{{username}}",
  "password": "{{password}}"
}

###

# Protected endpoint — run BEFORE login (or after server restart) to see 401
GET {{baseUrl}}/api/users

###

# Protected endpoint — ignores any saved JSESSIONID, even after login (expect 401).
# @no-cookie-jar forces a fresh client with no session cookie attached.
# @no-cookie-jar
GET {{baseUrl}}/api/users

###

# Fresh-session login (does NOT save the returned cookie).
# Useful to verify credentials without polluting the cookie jar.
# Requires a CSRF token from a prior GET /api/auth/csrf (header only; cookie jar skipped).
# @no-cookie-jar
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "username": "{{username}}",
  "password": "{{password}}"
}

###

# Login — wrong credentials (expect 401)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "username": "{{username}}",
  "password": "wrong-password"
}

###

# Login — blank fields (expect 400 validation error)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json
X-XSRF-TOKEN: {{csrfToken}}

{
  "username": "",
  "password": ""
}

###

# Login — missing CSRF (expect 403)
POST {{baseUrl}}/api/auth/login
Content-Type: application/json

{
  "username": "{{username}}",
  "password": "{{password}}"
}

###

# Current user — validates the session cookie (run while logged in; expect 200
# with username + role). Use this to check if the browser's cookie is still valid.
GET {{baseUrl}}/api/auth/me

###

# Current user — without a session (expect 401, signals an invalid/expired cookie).
# @no-cookie-jar
GET {{baseUrl}}/api/auth/me

###

# Logout — clears the session and XSRF-TOKEN cookie (run while logged in; expect 200).
POST {{baseUrl}}/api/auth/logout
X-XSRF-TOKEN: {{csrfToken}}

###

# Logout — without a session (expect 401, since logout requires authentication).
# @no-cookie-jar
POST {{baseUrl}}/api/auth/logout
X-XSRF-TOKEN: {{csrfToken}}
